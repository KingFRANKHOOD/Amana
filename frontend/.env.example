NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_CONTRACT_ID=
NEXT_PUBLIC_FREIGHTER_ENABLED=true
NEXT_PUBLIC_ALBEDO_URL=https://albedo.link
NEXT_PUBLIC_API_URL=http://localhost:4000
# Wallet balance polling interval in milliseconds (default: 30000).
# Lower it for faster testnet demos, raise it to reduce load on a self-hosted
# Horizon node. Invalid or non-positive values fall back to 30000.
NEXT_PUBLIC_WALLET_BALANCE_REFRESH_MS=30000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
PINATA_JWT=
PINATA_GATEWAY_URL=

# Playwright E2E / visual tests (see TESTING.md)
# Front-end origin under test; when set, the bundled dev server is not started.
PLAYWRIGHT_BASE_URL=http://localhost:3000
# Backend API origin that specs mock via page.route(); falls back to NEXT_PUBLIC_API_URL.
PLAYWRIGHT_API_URL=http://localhost:4000

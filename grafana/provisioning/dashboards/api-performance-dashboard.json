      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
      "id": 11,
      "title": "Response Status Code Distribution (2xx / 4xx / 5xx)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (status_group) (rate(http_request_duration_ms_count[5m]))",
          "legendFormat": "Status {{status_group}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
